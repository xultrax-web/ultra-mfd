  "tokenColors": [
    {
      "name": "Comments — dim phosphor",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.block.documentation",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7AB527"
      }
    },
    {
      "name": "Variables — stencil",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.parameter",
        "variable.language",
        "entity.name.variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#F0E8D5"
      }
    },
    {
      "name": "Strings — phosphor hot (ok tonal)",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Numbers — phosphor hot",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.binary"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Constants — phosphor hot",
      "scope": [
        "constant",
        "constant.language",
        "constant.character",
        "constant.character.escape",
        "constant.other"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Keywords — phosphor bright (the accent)",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.conditional",
        "keyword.control.return",
        "keyword.control.loop",
        "keyword.other",
        "keyword.operator.new",
        "keyword.operator.delete"
      ],
      "settings": {
        "foreground": "#F0E8D5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage — phosphor bright",
      "scope": [
        "storage",
        "storage.type",
        "storage.type.function",
        "storage.type.class",
        "storage.type.interface",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F0E8D5"
      }
    },
    {
      "name": "Functions — phosphor bright",
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "support.function",
        "support.function.builtin",
        "meta.function-call entity.name.function",
        "meta.function entity.name.function"
      ],
      "settings": {
        "foreground": "#F0E8D5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types and classes — cool white",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.enum",
        "entity.name.interface",
        "support.type",
        "support.class",
        "support.constant",
        "meta.type",
        "meta.return-type"
      ],
      "settings": {
        "foreground": "#B8C0D2"
      }
    },
    {
      "name": "Tags (HTML/XML/JSX) — cool white",
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name",
        "punctuation.definition.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#B8C0D2"
      }
    },
    {
      "name": "Operators — phosphor deep",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#4D7019"
      }
    },
    {
      "name": "Punctuation (braces, brackets) — body phosphor",
      "scope": [
        "punctuation",
        "punctuation.section",
        "punctuation.definition.parameters",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#9FE633"
      }
    },
    {
      "name": "Decorators / annotations — phosphor bright",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "support.type.annotation"
      ],
      "settings": {
        "foreground": "#F0E8D5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Regex — phosphor hot",
      "scope": [
        "string.regexp",
        "punctuation.definition.string.regexp",
        "constant.character.character-class.regexp",
        "keyword.control.anchor.regexp"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Invalid — bad / rust",
      "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
      "settings": {
        "foreground": "#FF6A3D"
      }
    },
    {
      "name": "Markdown headings — phosphor bright",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#F0E8D5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold — stencil",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#F0E8D5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic — body phosphor (no italic style)",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#9FE633"
      }
    },
    {
      "name": "Markdown links — phosphor hot",
      "scope": ["markup.underline.link", "string.other.link", "constant.other.reference.link"],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Markdown inline code — cool white",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#B8C0D2"
      }
    },
    {
      "name": "Markdown quote — phosphor dim",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#7AB527"
      }
    },
    {
      "name": "JSON keys — stencil",
      "scope": ["support.type.property-name.json", "support.type.property-name"],
      "settings": {
        "foreground": "#F0E8D5"
      }
    },
    {
      "name": "CSS properties — stencil",
      "scope": ["support.type.property-name.css", "meta.property-name.css"],
      "settings": {
        "foreground": "#F0E8D5"
      }
    },
    {
      "name": "CSS selectors — phosphor bright",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#F0E8D5"
      }
    },
    {
      "name": "Git diff — added (ok)",
      "scope": ["markup.inserted", "punctuation.definition.inserted"],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Git diff — removed (bad)",
      "scope": ["markup.deleted", "punctuation.definition.deleted"],
      "settings": {
        "foreground": "#FF6A3D"
      }
    },
    {
      "name": "Git diff — changed (caution)",
      "scope": ["markup.changed", "punctuation.definition.changed"],
      "settings": {
        "foreground": "#E8B020"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#B8C0D2",
    "class": "#B8C0D2",
    "interface": "#B8C0D2",
    "enum": "#B8C0D2",
    "type": "#B8C0D2",
    "typeParameter": "#B8C0D2",
    "function": "#F0E8D5",
    "method": "#F0E8D5",
    "macro": "#FFFFFF",
    "variable": "#F0E8D5",
    "parameter": "#F0E8D5",
    "property": "#F0E8D5",
    "enumMember": "#FFFFFF",
    "event": "#F0E8D5",
    "decorator": "#F0E8D5",
    "label": "#4D7019",
    "string": "#FFFFFF",
    "number": "#FFFFFF",
    "regexp": "#FFFFFF",
    "operator": "#4D7019",
    "keyword": "#F0E8D5",
    "modifier": "#F0E8D5",
    "comment": "#7AB527",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.deprecated": {
      "foreground": "#FF6A3D",
      "strikethrough": true
    }
  }
}
